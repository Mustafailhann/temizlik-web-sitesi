
@using Entity.Concreate
@model UI.Models.HomeViewModel

@{
    Layout = null;
}

<!-- basic -->
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!-- mobile metas -->
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="viewport" content="initial-scale=1, maximum-scale=1">
<!-- site metas -->
<title> cleaned</title>
<meta name="keywords" content="">
<meta name="description" content="">
<meta name="author" content="">
<!-- bootstrap css -->
<link rel="stylesheet" href="~/better-clean/css/bootstrap.min.css">
<!-- style css -->
<link rel="stylesheet" href="~/better-clean/css/style.css">
<!-- Responsive-->
<link rel="stylesheet" href="~/better-clean/css/responsive.css">
<!-- fevicon -->
<link rel="icon" href="~/better-clean/images/fevicon.png" type="image/gif" />
<!-- Scrollbar Custom CSS -->
<link rel="stylesheet" href="css/jquery.mCustomScrollbar.min.css">
<!-- Tweaks for older IEs-->
<link rel="stylesheet" href="https://netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.css" media="screen">
<!--[if lt IE 9]>
<script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
<script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script><![endif]-->
</head>


<style>
    .table {
        width: 100%;
        border-collapse: separate; /* Kenarlıklar ayrı ayrı gösterilsin */
        border-spacing: 10px; /* Kolonlar arasında boşluk */
        margin: 20px 0;
        font-size: 16px;
        font-family: Arial, sans-serif;
        background-color: #f9f9f9; /* Tablo arka plan rengi */
        border-radius: 10px; /* Köşeleri yuvarlak yap */
        overflow: hidden; /* Köşe yuvarlaklığı için */
    }

        .table thead th {
            background-color: #007bff;
            color: white;
            padding: 15px; /* Başlık hücrelerinin iç boşluğu */
            text-align: left;
            border: 1px solid #ddd; /* Kenarlık ekle */
        }

        .table tbody td {
            padding: 15px; /* Hücre içi boşluk */
            border: 1px solid #ddd; /* Kenarlık ekle */
            background-color: white; /* Hücre arka plan rengi */
        }

        .table tbody tr:hover {
            background-color: #f1f1f1; /* Fare ile üzerine gelindiğinde arka plan rengi */
        }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .text-center {
        text-align: center;
    }
</style>

<!-- body -->
<body class="main-layout">
    <!-- loader  -->
    <div class="loader_bg">
        <div class="loader"><img src="~/better-clean/images/loading.gif" alt="#" /></div>
    </div>
    <div class="col-xl-9 col-lg-9 col-md-9 col-md-9 >
        <div class="menu-area">
            <div class="limit-box">
                <nav class="main-menu">
                    <ul class="menu-area-main">
                        <li class="active"> <a href="index.html"></a> </li>


                        <li> <a href="@Url.Action("SiparisGoruntule", "Admin")"> SİPARİŞLER </a> </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>



    @if (Session["RolId"] == null)
    {
        <div class="alert alert-warning">
            Lütfen önce giriş yapın.
        </div>
    }
    else
    {
        <h2>Siparişler</h2>
        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Sipariş ID</th>
                    <th>Müşteri ID</th>
                    <th>Personel ID</th>
                    <th>Müşteri Adı</th>
                    <th>Müşteri Soyadı</th>
                    <th>Sipariş Tarihi</th>
                    <th>Teslim Tarihi</th>
                    <th>Geçen Zaman (dk)</th>
                    <th>Durum</th>
                    <th>Ara</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Siparisler != null && Model.Siparisler.Any())
                {
                    foreach (var item in Model.Siparisler)
                    {
                        var gecenSure = (item.siparisTarih != null)
                          ? (DateTime.Now - item.siparisTarih).TotalMinutes
                                                                         : 0;

                        var durum = gecenSure >= 40 ? "Aranmadı" : "Beklemede";

                        <tr>
                            <td>@item.SiparisId</td>
                            <td>@item.MusteriId</td>
                            <td>@item.PersonelId</td>
                            <td>@item.MusteriAdi</td>
                            <td>@item.MusteriSoyadi</td>
                            <td>@item.siparisTarih</td>
                            <td>@item.teslimTarih</td>
                            <td>@Math.Floor(gecenSure) dk</td>
                            <td id="durum-@item.SiparisId">@durum</td>
                            <td>
                                <button class="btn btn-success" onclick="siparisArandi(@item.SiparisId)">Ara</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">Hiç sipariş bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <script>
        function siparisArandi(siparisId) {
            var durumTd = document.getElementById("durum-" + siparisId);
            if (durumTd) {
                durumTd.innerText = "Arandı";
                durumTd.style.color = "green"; // Durum yazısını yeşil yap
            }
        }
    </script>



    </footer>
    <!-- end footer -->
    <!-- Javascript files-->
    <script src="~/better-clean/js/jquery.min.js"></script>
    <script src="~/better-clean/js/popper.min.js"></script>
    <script src="~/better-clean/js/bootstrap.bundle.min.js"></script>
    <script src="~/better-clean/js/jquery-3.0.0.min.js"></script>
    <script src="~/better-clean/js/plugin.js"></script>
    <!-- sidebar -->
    <script src="~/better-clean/js/jquery.mCustomScrollbar.concat.min.js"></script>
    <script src="~/better-clean/js/custom.js"></script>
    <script src="https:cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.js"></script>
    <script>
        // This example adds a marker to indicate the position of Bondi Beach in Sydney,
        // Australia.
        function initMap() {
            var map = new google.maps.Map(document.getElementById('map'), {
                zoom: 11,
                center: {
                    lat: 40.645037,
                    lng: -73.880224
                },
            });

            var image = 'images/maps-and-flags.png';
            var beachMarker = new google.maps.Marker({
                position: {
                    lat: 40.645037,
                    lng: -73.880224
                },
                map: map,
                icon: image
            });
        }</script>
    <!-- google map js -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA8eaHt9Dh5H57Zh0xVTqxVdBFCvFMqFjQ&callback=initMap"></script>
    <!-- end google map js -->
</body>
</html>