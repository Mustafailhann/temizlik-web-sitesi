<!-- wellcome  -->
<div id="hakkımızda" class="wellcome">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>TEMİZLİK FARKINI KEŞFEDİN!</h2>
                    <p>
                        Küçük dokunuşlarla büyük değişimler yaratıyoruz! Profesyonel temizlik hizmetlerimizle yaşam alanlarınızı, ofislerinizi ve araçlarınızı pırıl pırıl hale getiriyoruz. Sağlıklı, hijyenik ve ferah bir ortam için SoftTemizlik’i tercih edin! 💎🚿
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                <div class="wellcome-box">
                    <figure><img src="~/better-clean/images/ofistemizkirli.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                <div class="wellcome-box">
                    <figure><img src="~/better-clean/images/temizkirliaraba.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                <div class="wellcome-box">
                    <figure><img src="~/better-clean/images/temizkirli2.jpg" alt="#" /></figure>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                <div class="wellcome-box">
                    <figure><img src="~/better-clean/images/temizkirli.jpg" alt="#" /></figure>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- end wellcome -->
<!-- ourwork -->
<div id="ourwork" class="ourwork">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>İŞ SÜRECİMİZ</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="main_slider1" class="carousel slide banner-main3" data-ride="carousel">
                    <div class="carousel-inner">
                        @{
                            bool first = true; // İlk öğeye "active" sınıfını vermek için
                        }
                        @foreach (var item in Model.Hizmetler)
                        {
                            <div class="carousel-item @(first ? "active" : "")">
                                <div class="container">
                                    <div class="carousel-caption">
                                        <div class="row d_flex">
                                            <div class="col-md-4">
                                                <div class="our">
                                                    <p>@item.Aciklama</p>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="our">
                                                    <figure><img src="@item.Foto" height="80" width="80" /></figure>
                                                    <p>@item.HizmetAdi.ToUpper()</p>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="our">
                                                    <p style="font-size:20px">@item.Fiyat <b>TL</b></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            first = false;
                        }
                    </div>
                    <a class="carousel-control-prev" href="#main_slider1" role="button" data-slide="prev">
                        <i class="fa fa-long-arrow-left" aria-hidden="true"></i>
                    </a>
                    <a class="carousel-control-next" href="#main_slider1" role="button" data-slide="next">
                        <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end ourwork -->
<!-- Better -->
<div>
    <section class="Better">
        <div class="container">
            <div class="row">
                <div class="Better_clean">
                    <figure><img src="~/better-clean/images/soft.jpeg" /></figure>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- end Better -->
<!-- review -->
<div id="review" class="review">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Müşteri Yorumları</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="main_slider" class="carousel slide banner-main2" data-ride="carousel">
                    <div class="carousel-inner">
                        @foreach (var review in Model.Yorumlar)
                        {
                            <div class="carousel-item @(review == Model.Yorumlar.First() ? "active" : "")">
                                <div class="container">
                                    <div class="carousel-caption">
                                        <img src="~/better-clean/images/f3d1edf10d63c40e1fa06364176fa502-removebg-preview.png" height="130px" width="130px" />
                                        <span>⭐@review.Puan/5</span>
                                        <span>@(review.Siparis?.Musteri?.MusteriAdi ?? "Bilinmiyor") @(review.Siparis?.Musteri?.MusteriSoyadi ?? "Bilinmiyor")</span>
                                        <p>@review.YorumAciklamasi</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <a class="carousel-control-prev" href="#main_slider" role="button" data-slide="prev">
                        <i class='fa fa-angle-left'></i>
                    </a>
                    <a class="carousel-control-next" href="#main_slider" role="button" data-slide="next">
                        <i class='fa fa-angle-right'></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- end review -->
<div id="request" class="contact">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 padding-left1">
                <div class="contact">
                    <div class="titlepage">
                        <h2>SİPARİŞ KAYDI OLUŞTUR</h2>
                    </div>
                    <form class="request" method="post" action="@Url.Action("Siparisolustur", "Anasayfa")">
                        <div class="row">
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Ad" type="text" name="MusteriAdi">
                            </div>
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Soyad" type="text" name="MusteriSoyadi">
                            </div>
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Telefon Numarası" type="text" name="Telefon">
                            </div>
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Mail Adresi" type="email" name="Email">
                            </div>
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Adres" type="text" name="Adres">
                            </div>

                            <div class="col-sm-12">
                                <label for="ServiceId"></label>
                                <select class="contactus" id="ServiceId" name="hizmetId">
                                    <option value="">Hizmet Seçiniz</option>
                                    @foreach (var hizmet in Model.Hizmetler)
                                    {
                                        <option value="@hizmet.HizmetId" @(Model.secilihizmetid == hizmet.HizmetId ? "selected" : "")>
                                            @hizmet.HizmetAdi
                                        </option>
                                    }
                                </select>
                            </div>

                            @if (Model.Personeller.Any())
                            {
                                <div class="col-sm-12">
                                    <label for="PersonelId"></label>
                                    <select class="contactus" id="PersonelId" name="PersonelId">
                                        <option value="">Personel Seçiniz</option>
                                        @foreach (var personel in Model.Personeller)
                                        {
                                            <option value="@personel.PersonelId">@personel.PersonelAdi</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-sm-12">
                                <input class="contactus" placeholder="Tarih" type="date" name="TeslimTarihi">
                            </div>
                            <div class="col-sm-12">
                                <button class="send">SİPARİŞ TALEBİ OLUŞTUR</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 padding-right1">
                <div id="map">
                </div>
            </div>
        </div>
    </div>
</div>
















