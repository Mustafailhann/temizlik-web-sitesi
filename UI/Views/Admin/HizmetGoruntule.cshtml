@using Entity.Concreate
@model UI.Models.HomeViewModel
@{
    Layout = null;
}

<style>
    .table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 10px;
        margin: 20px 0;
        font-size: 16px;
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        border-radius: 10px;
        overflow: hidden;
    }

        .table thead th {
            background-color: #007bff;
            color: white;
            padding: 15px;
            text-align: left;
            border: 1px solid #ddd;
        }

        .table tbody td {
            padding: 15px;
            border: 1px solid #ddd;
            background-color: white;
        }

        .table tbody tr:hover {
            background-color: #f1f1f1;
        }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-success:hover {
        background-color: #218838;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .text-center {
        text-align: center;
    }

    .add-button {
        display: flex;
        justify-content: flex-end;
        margin-top: 15px;
    }
</style>

@if (Session["RolId"] == null)
{
    <div class="alert alert-warning">
        Lütfen önce giriş yapın.
    </div>
}
else
{
    <h2>HİZMETLER</h2>
    <table class="table table-striped table-bordered table-hover">
        <thead class="thead-light">
            <tr>
                <th>Hizmet Adı</th>
                <th>Açıklama</th>
                <th>Fiyat</th>
                <th>İşlemler</th> <!-- Silme butonu için yeni sütun -->
            </tr>
        </thead>
        <tbody>
            @if (Model.Hizmetler != null && Model.Hizmetler.Any())
            {
                foreach (var item in Model.Hizmetler)
                {
                    <tr id="row-@item.HizmetId">
                        <td>@item.HizmetAdi</td>
                        <td>@item.Aciklama</td>
                        <td>@item.Fiyat</td>
                        <td>
                            <button class="btn-danger" onclick="Sil(@item.HizmetId)">Sil</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Hiç hizmet bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="add-button">
        <a href="@Url.Action("HizmetEkle", "Admin")" class="btn-success">Hizmet Ekle</a>
    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function Sil(hizmetId) {
        if (confirm("Bu hizmeti silmek istediğinizden emin misiniz?")) {
            $.ajax({
                url: '@Url.Action("HizmetSil", "Admin")',
                type: 'POST',
                data: { id: hizmetId },
                success: function(response) {
                    if (response.success) {
                        alert("Hizmet başarıyla silindi!");
                        $("#row-" + hizmetId).remove(); // Silinen hizmeti tabloda kaldır
                    } else {
                        alert("Hata: " + response.message);
                    }
                },
                error: function() {
                    alert("Silme işlemi sırasında bir hata oluştu.");
                }
            });
        }
    }
</script>
