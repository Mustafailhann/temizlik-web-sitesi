@using Entity.Concreate
@model UI.Models.HomeViewModel
@{
    Layout = null;
}

@if (Session["RolId"] == null)
{
    <div class="alert alert-warning">
        Lütfen önce giriş yapın.
    </div>
}
else
{
    <h2>Siparişler</h2>
    <table class="table table-striped table-bordered table-hover">
        <thead class="thead-light">
            <tr>
                <th>Personel ID</th>
                <th>Müşteri Adı</th>
                <th>Müşteri Soyadı</th>
                <th>Sipariş Tarihi</th>
                <th>Teslim Tarihi</th>
                <th>Sipariş Durumu</th>

            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Siparisler)
            {
                <tr>
                    <td>@item.PersonelId</td>
                    <td>@item.MusteriAdi</td>
                    <td>@item.MusteriSoyadi</td>
                    <td>@item.siparisTarih</td>
                    <td>@item.teslimTarih</td>
                    <td>@item.siparisDurum</td>

                </tr>
            }
            @if (Model.Siparisler == null)
            {
                <tr>
                    <td colspan="10" class="text-center">Hiç sipariş bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
}

