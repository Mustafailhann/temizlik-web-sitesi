@model Entity.Concreate.Personel
@{
    Layout = null;
}

<div class="container">
    <h2>Giriş Yap</h2>
    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label for="name">Kullanıcı Adı:</label>
            @Html.TextBoxFor(model => model.kullaniciAdi, new { @class = "form-control", placeholder = "Kullanıcı Adı" })
        </div>

        <div class="form-group">
            <label for="password">Şifre:</label>
            @Html.PasswordFor(model => model.sifre, (object)new { @class = "form-control", placeholder = "Şifre" })
        </div>

        <button type="submit" class="btn btn-primary">Giriş Yap</button>
    }
</div>