@using UI.Models
@model HomeViewModel

@{
    ViewBag.Title = "Personel Görüntüle";
}

@if (Session["RolId"] == null)
{
    <div class="alert alert-warning">
        Lütfen önce giriş yapın.
    </div>
}
else
{
    <!-- Personel Listesi -->
    <h3>Personel Listesi</h3>
    
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Personel Adı Soyadı</th>
                    <th>Kullanıcı Adı</th>
                    <th>Telefon</th>
                    <th>İşlemler</th> <!-- Silme butonu için sütun -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Personeller)
                {
                    <tr id="row-@item.PersonelId">
                        <td>@item.PersonelAdi</td>
                        <td>@item.PersonelSoyadi</td>
                        <td>@item.Telefon</td>
                        <td>
                            <button class="btn btn-danger" onclick="Sil(@item.PersonelId)">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    <div class="add-button" style="margin-top: 20px;">
        <a href="@Url.Action("PersonelEkle", "Admin")" class="btn btn-success">Personel Ekle</a>
    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function Sil(personelId) {
        if (confirm("Bu personeli silmek istediğinizden emin misiniz?")) {
            $.ajax({
                url: '@Url.Action("Sil", "Admin")',
                type: 'POST',
                data: { id: personelId },
                success: function(response) {
                    if (response.success) {
                        alert("Personel başarıyla silindi!");
                        $("#row-" + personelId).remove(); // Silinen personeli tabloda kaldır
                    } else {
                        alert("Hata: " + response.message);
                    }
                },
                error: function() {
                    alert("Silme işlemi sırasında bir hata oluştu.");
                }
            });
        }
    }
</script>
